FROM ubuntu:22.04

# Install SSH and Python
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    openssh-server \
    sudo \
    python3 \
    bsdutils \
    && rm -rf /var/lib/apt/lists/*

# Create user with BASH shell
RUN useradd -m -s /bin/bash admin && \
    echo "admin:password123" | chpasswd && \
    usermod -aG sudo admin

# Create root password with BASH shell
RUN echo "root:toor" | chpasswd
RUN usermod -s /bin/bash root  # Force bash for root too

# Configure SSH for maximum logging
RUN mkdir /var/run/sshd
RUN echo "PermitRootLogin yes" >> /etc/ssh/sshd_config
RUN echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
RUN echo "AllowUsers admin root" >> /etc/ssh/sshd_config
RUN echo "LogLevel VERBOSE" >> /etc/ssh/sshd_config
RUN echo "MaxAuthTries 100" >> /etc/ssh/sshd_config
RUN ln -sf /proc/1/fd/1 /var/log/auth.log
RUN ln -sf /proc/1/fd/2 /var/log/auth.err

# Create log directory FIRST
RUN mkdir -p /var/log/ssh_sessions && chmod 777 /var/log/ssh_sessions

# Command logging configuration - SIMPLE VERSION
RUN echo 'log_command() {' >> /etc/bash.bashrc
RUN echo '  echo "$(date "+%Y-%m-%d %H:%M:%S") | $(whoami) | ${SSH_CLIENT%% *} | $(history 1 | sed "s/^[ ]*[0-9]\+[ ]*//")" >> /var/log/ssh_sessions/commands.log' >> /etc/bash.bashrc
RUN echo '}' >> /etc/bash.bashrc
RUN echo 'export PROMPT_COMMAND="log_command"' >> /etc/bash.bashrc
RUN echo 'export HISTSIZE=10000' >> /etc/bash.bashrc
RUN echo 'export HISTFILESIZE=10000' >> /etc/bash.bashrc
RUN echo 'export HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S "' >> /etc/bash.bashrc
RUN echo 'shopt -s histappend' >> /etc/bash.bashrc

# Color prompt for bash
RUN echo 'export PS1="\[\033[1;32m\]\u@\h\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\\$ "' >> /etc/bash.bashrc
RUN echo 'alias ls="ls --color=auto"' >> /etc/bash.bashrc
RUN echo 'alias ll="ls -la --color=auto"' >> /etc/bash.bashrc

# Copy logger script
COPY containers/ssh_Logger.py /ssh_Logger.py
RUN chmod +x /ssh_Logger.py

# Generate SSH host keys
RUN ssh-keygen -A

EXPOSE 22

# Start with our logger
CMD ["python3", "/ssh_Logger.py"]